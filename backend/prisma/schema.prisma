/// 32. 회원·콘텐츠·마감별 D-1 작업; 같은 마감의 복수 경로는 한 알림으로 묶음
/// SQL-only CHECKs: ck_deadline_reminders_precision, ck_deadline_reminders_window, ck_deadline_reminders_attempts, ck_deadline_reminders_next_attempt, ck_deadline_reminders_lease, ck_deadline_reminders_terminal
/// Service must require exactly one complete notice/summary OR program/revision pair.
model DeadlineReminder {
  id                BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  userId            BigInt                    @map("user_id") @db.UnsignedBigInt
  noticeId          BigInt?                   @map("notice_id") @db.UnsignedBigInt
  noticeSummaryId   BigInt?                   @map("notice_summary_id") @db.UnsignedBigInt
  programId         BigInt?                   @map("program_id") @db.UnsignedBigInt
  programRevisionId BigInt?                   @map("program_revision_id") @db.UnsignedBigInt
  /// SHA-256 canonical D1 event identity: content kind/id and normalized precision/value; excludes revision, bookmark time and channel.
  /// SQL collation: ascii_bin (must be preserved in migration SQL).
  dedupKey          String                    @map("dedup_key") @db.Char(64)
  /// Scheduling contract, initially deadline-d1-v1; NOT part of dedup_key.
  policyVersion     String                    @map("policy_version") @db.VarChar(32)
  /// SQL collation: ascii_bin (must be preserved in migration SQL).
  deadlinePrecision ReminderDeadlinePrecision @map("deadline_precision")
  deadlineDate      DateTime?                 @map("deadline_date") @db.Date
  deadlineAt        DateTime?                 @map("deadline_at") @db.DateTime(3)
  /// Non-empty validated list of period/item/session or program-root deadline references in the selected version.
  sourceRefsJson    Json                      @map("source_refs_json") @db.Json
  scheduledAt       DateTime                  @map("scheduled_at") @db.DateTime(3)
  /// Exclusive retry/send cutoff; policy timestamp, NOT an invented source deadline.
  deliverBefore     DateTime                  @map("deliver_before") @db.DateTime(3)
  /// SQL collation: ascii_bin (must be preserved in migration SQL).
  status            DeadlineReminderStatus    @default(PENDING)
  nextAttemptAt     DateTime                  @map("next_attempt_at") @db.DateTime(3)
  attemptCount      Int                       @default(0) @map("attempt_count") @db.Int
  /// SQL collation: ascii_bin (must be preserved in migration SQL).
  lockToken         String?                   @map("lock_token") @db.Char(36)
  lockedUntil       DateTime?                 @map("locked_until") @db.DateTime(3)
  /// Notification and push outbox creation committed; not proof of push delivery.
  completedAt       DateTime?                 @map("completed_at") @db.DateTime(3)
  cancelledAt       DateTime?                 @map("cancelled_at") @db.DateTime(3)
  cancelReason      String?                   @map("cancel_reason") @db.VarChar(64)
  lastError         String?                   @map("last_error") @db.Text
  createdAt         DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime                  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  user            User             @relation("UserDeadlineReminders", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_deadline_reminders_01")
  noticeSummary   NoticeSummary?   @relation("ReminderNoticeSummary", fields: [noticeId, noticeSummaryId], references: [noticeId, id], onDelete: Restrict, onUpdate: NoAction, map: "fk_deadline_reminders_02")
  programRevision ProgramRevision? @relation("ReminderProgramRevision", fields: [programId, programRevisionId], references: [programId, id], onDelete: Restrict, onUpdate: NoAction, map: "fk_deadline_reminders_03")
  /// Prisma inverse list; Notification.reminderId remains UNIQUE (zero/one row).
  notifications   Notification[]   @relation("ReminderNotification")

  @@unique([userId, dedupKey], map: "uq_deadline_reminders_01")
  @@unique([id, userId], map: "uq_deadline_reminders_02")
  @@index([status, nextAttemptAt], map: "idx_deadline_reminders_03")
  @@index([status, lockedUntil], map: "idx_deadline_reminders_04")
  @@index([noticeId, noticeSummaryId, status], map: "idx_deadline_reminders_05")
  @@index([programId, programRevisionId, status], map: "idx_deadline_reminders_06")
  @@map("deadline_reminders")
}

