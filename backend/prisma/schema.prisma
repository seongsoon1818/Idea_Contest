  lastErrorMessage String?            @map("last_error_message") @db.Text
  createdAt        DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  notification Notification        @relation("NotificationPushDeliveries", fields: [notificationId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction, map: "fk_notification_push_deliveries_01")
  subscription WebPushSubscription @relation("SubscriptionPushDeliveries", fields: [subscriptionId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction, map: "fk_notification_push_deliveries_02")

  @@unique([notificationId, subscriptionId], map: "uq_notification_push_deliveries_01")
  @@index([status, nextAttemptAt], map: "idx_notification_push_deliveries_02")
  @@index([status, lockedUntil], map: "idx_notification_push_deliveries_03")
  @@index([subscriptionId, userId, status], map: "idx_notification_push_deliveries_04")
  @@index([notificationId, userId], map: "idx_notification_push_deliveries_05")
  @@map("notification_push_deliveries")
}
