/// ACTIVE=정상 계정; SUSPENDED=이용 정지; WITHDRAWN=탈퇴 처리 상태. 탈퇴 표시만으로 개인정보가 삭제되는 것은 아님.
enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

/// MEMBER=일반 회원; REVIEWER=콘텐츠 검토자; ADMIN=관리자. 권한 부여·검사는 서버 책임.
enum UserRole {
  MEMBER
  REVIEWER
  ADMIN
}

/// YEAR_1~YEAR_4=1~4학년; OTHER=기타. OTHER를 전 학년이나 미상으로 대체하지 않음.
enum GradeCode {
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
  OTHER
}

/// COLLEGE=대학; DEPARTMENT=학부·학과; TRACK=트랙.
enum AcademicUnitKind {
  COLLEGE
  DEPARTMENT
  TRACK
}

/// NOTICE=학교 공지 출처; PROGRAM=프로그램 출처.
enum SourceKind {
  NOTICE
  PROGRAM
}

/// PUBLIC=노출 가능; HIDDEN=서비스에서 숨김; REMOVED_AT_SOURCE=원문 삭제 확인. PUBLIC만으로 AI 요약 공개가 승인되지는 않음.
enum VisibilityStatus {
  PUBLIC
  HIDDEN
  REMOVED_AT_SOURCE
}

/// QUEUED=대기; RUNNING=실행; COMPLETED=완료; FAILED=실패; CANCELLED=취소. 완료와 사람의 공개 승인은 다름.
enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// INITIAL=초기 전체 수집; INCREMENTAL=증분; RECHECK=변경 재확인; FILE_IMPORT=저장 파일 입력.
enum CrawlMode {
  INITIAL
  INCREMENTAL
  RECHECK
  FILE_IMPORT
}

/// DISCOVERED=발견; UNCHANGED=내용 동일; CREATED=신규; UPDATED=변경; FAILED=처리 오류; UNAVAILABLE=접근/확인 불가. UNAVAILABLE을 원문 삭제 확정으로 보지 않음.
enum CrawlRecordStatus {
  DISCOVERED
  UNCHANGED
  CREATED
  UPDATED
  FAILED
  UNAVAILABLE
}

/// IMAGE=본문 이미지; ATTACHMENT=첨부파일.
enum AssetKind {
  IMAGE
  ATTACHMENT
}

/// REMOTE_ONLY=원본 참조만 보유; STORED=저장소 보관 완료; FAILED=보관 실패.
enum AssetStorageStatus {
  REMOTE_ONLY
  STORED
  FAILED
}

/// PENDING=승인 전; APPROVED=검토 승인; REJECTED=이 요약 버전 반려. 공개 포인터 선택은 별도.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// AI=모델 결과를 바탕으로 작성(검토자 수정 포함); HUMAN=완전 수동 작성. AI이면 분석 연결 필수라는 규칙은 서비스에서 검사.
enum SummaryOrigin {
  AI
  HUMAN
}

/// recruitment=채용; education=교육 모집; academic_application=학사 신청; scholarship_policy=장학·선발기준; event=행사; survey=설문; collection=모음글; general=일반 안내.
enum NoticeKind {
  recruitment
  education
  academic_application
  scholarship_policy
  event
  survey
  collection
  general
}

/// stated=신청 기간/마감 명시; not_stated=신청은 있으나 기간/마감 미기재; not_applicable=신청 개념 없음. 접수 중/마감 상태가 아님.
enum ApplicationStatus {
  stated
  not_stated
  not_applicable
}

/// UNKNOWN=미확인/표현 불가; ALL=해당 차원에 명시적 제한 없음; RESTRICTED=검토한 필수 대상 목록. 우대·추천 목록과 별개.
enum EligibilityScope {
  UNKNOWN
  ALL
  RESTRICTED
}

/// REQUIRED=필수 학년/소속 제한; PREFERRED=실제 선발 우대·가산점; RECOMMENDED=권장 대상. 후자 둘은 신청 불가 판정에 사용 금지.
enum TargetPurpose {
  REQUIRED
  PREFERRED
  RECOMMENDED
}

/// date=날짜만 확정; datetime=시각까지 확정; unknown=원문은 있으나 확정 불가. SQL NULL은 경계 자체가 없음.
enum DatePrecision {
  date
  datetime
  unknown
}

/// APPLICATION=신청; ACTIVITY=활동·교육·행사; RESULT=결과 발표; OTHER=기타.
enum PeriodRole {
  APPLICATION
  ACTIVITY
  RESULT
  OTHER
}

/// VALID=현재 검증 규칙 통과; NEEDS_REVIEW=미검사/추가 검토; INVALID=형식·관계 등의 위반. 최종 신청 자격이나 모든 사실의 정확성 보증이 아님.
enum ValidationStatus {
  VALID
  NEEDS_REVIEW
  INVALID
}

/// date=달력일만 확정; datetime=시각까지 확정. D18과 달리 unknown은 금지.
enum ReminderDeadlinePrecision {
  date
  datetime
}

/// PENDING=대기/재시도; PROCESSING=lease 선점; COMPLETED=알림·푸시 대기 생성 완료; CANCELLED=대상/설정 변경으로 취소; EXPIRED=발송 가능 시간 초과; FAILED=재시도 상한/영구 오류. COMPLETED는 푸시 수신 완료 아님.
enum DeadlineReminderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

/// PENDING=대기; PROCESSING=선점; RETRY_WAIT=일시 실패 후 대기; ACCEPTED=공급자 접수; FAILED=최종 실패; CANCELLED=사용자/콘텐츠 사유 중단; EXPIRED=발송 시간 초과. ACCEPTED는 단말 표시·읽음 보장 아님.
enum PushDeliveryStatus {
  PENDING
  PROCESSING
  RETRY_WAIT
  ACCEPTED
  FAILED
  CANCELLED
  EXPIRED
}

/// 01. 회원 계정
model User {
  id           BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  /// Normalized lowercase ASCII login ID; case-insensitive login is a proposed policy.
  /// SQL collation: ascii_general_ci (must be preserved in migration SQL).
  loginId      String     @map("login_id") @db.VarChar(20)
  /// SQL collation: ascii_bin (must be preserved in migration SQL).
  passwordHash String     @map("password_hash") @db.VarChar(255)
  name         String     @db.VarChar(30)
  /// SQL collation: ascii_bin (must be preserved in migration SQL).
  status       UserStatus @default(ACTIVE)
  /// SQL collation: ascii_bin (must be preserved in migration SQL).
  role         UserRole   @default(MEMBER)
  lastLoginAt  DateTime?  @map("last_login_at") @db.DateTime(3)
  withdrawnAt  DateTime?  @map("withdrawn_at") @db.DateTime(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  profile              UserProfile?              @relation("UserProfile")
  sessions             UserSession[]             @relation("UserSessions")
  academicUnits        UserAcademicUnit[]        @relation("UserAcademicUnits")
  topics               UserTopic[]               @relation("UserTopics")
  reviewedSummaries    NoticeSummary[]           @relation("SummaryReviewer")
  noticeBookmarks      UserNoticeBookmark[]      @relation("UserNoticeBookmarks")
  programBookmarks     UserProgramBookmark[]     @relation("UserProgramBookmarks")
  notificationSettings UserNotificationSettings? @relation("UserNotificationSettings")
  pushSubscriptions    WebPushSubscription[]     @relation("UserWebPushSubscriptions")
  deadlineReminders    DeadlineReminder[]        @relation("UserDeadlineReminders")

  @@unique([loginId], map: "uq_users_01")
  @@map("users")
}

