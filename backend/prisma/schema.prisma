  completedAt DateTime?  @map("completed_at") @db.DateTime(3)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation("UserProfile", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_profiles_01")

  @@map("user_profiles")
}

