# env 파일 예시. 실사용 env파일을 올리지 말 것.
DATABASE_URL="mysql://app_user:app_password@localhost:3306/idea_contest"
# 생성 예: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
NODE_ENV=development
PORT=3000
# 웹 푸시 사용 시 3개를 함께 설정. 키 생성: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
