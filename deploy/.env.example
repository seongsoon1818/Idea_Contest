# Required by the database and API. Set these in deploy/.env.
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=

# Optional web push configuration.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# To enable Cloudflare Tunnel, uncomment the profile and supply the tunnel token.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=
