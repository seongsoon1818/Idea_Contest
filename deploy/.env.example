# Required. For an existing server, keep its current values and MySQL volume.
# Generate URL-safe values with: openssl rand -hex 32
# Never replace existing DB credentials merely by editing this file.
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=

# Site settings. Origins must be HTTPS without a trailing slash or path.
SITE_DOMAIN=hsupick.cloud
PUBLIC_ORIGIN=https://hsupick.cloud
ALLOWED_ORIGINS=https://hsupick.cloud
IMAGE_TAG=latest

# Optional DATABASE_URL override. By default Compose uses the internal db service
# and allowPublicKeyRetrieval=true. URL-encode a password containing URL delimiters.
# DATABASE_URL=mysql://hsupick:URL_ENCODED_PASSWORD@db:3306/idea_contest?allowPublicKeyRetrieval=true

# Optional web push configuration.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Existing Cloudflare Tunnel: origin service URL must be http://web:8080.
# Uncomment both lines to enable the connector; keep the existing token.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=
